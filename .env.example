# =============================================================================
# JARVIS — Environment Configuration Template
# =============================================================================

# ---------------------------------------------------------------------------
# Primary Cloud Engine — OpenRouter
# ---------------------------------------------------------------------------
# Get your API key at: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# System 1: High-Speed Decision Scoring & Intent Routing (~85ms, 0 output tokens)
OPENROUTER_DECISION_MODEL=microsoft/microsoft-decision-1

# System 2: Primary Conversational Brain (120B MoE, fast MTP generation, 100% free)
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# System 2: Zero-Cost Fallback Model (auto-routes across available free models)
OPENROUTER_FALLBACK_MODEL=openrouter/free

# ---------------------------------------------------------------------------
# Local Models (Optional — 100% private & offline via Ollama)
# ---------------------------------------------------------------------------
# Run `ollama run llama3.2:3b` or `ollama run phi3` in terminal first
# OLLAMA_MODEL=llama3.2:3b

# ---------------------------------------------------------------------------
# Secondary Cloud Providers (Optional Multi-LLM Cascade Fallbacks)
# ---------------------------------------------------------------------------
# NVIDIA NIM (DeepSeek V4 Flash) — https://build.nvidia.com/
# NVIDIA_API_KEY=your-nvidia-api-key-here

# Groq (Ultra-fast inference — Llama 3.3, Whisper STT, Orpheus TTS) — https://console.groq.com/
# GROQ_API_KEY=gsk_your_groq_key_here
# Optional rotation keys for higher quotas:
# GROQ_API_KEY_2=gsk_optional_key_2
# GROQ_API_KEY_3=gsk_optional_key_3

# Google Gemini (Conversational & Vision fallback) — https://aistudio.google.com/
# GEMINI_API_KEY=your-gemini-api-key-here

# ---------------------------------------------------------------------------
# Personalization
# ---------------------------------------------------------------------------
# Your name (JARVIS will address you by name)
USER_NAME=Tony

# How JARVIS addresses you (defaults to "sir")
HONORIFIC=sir

# ---------------------------------------------------------------------------
# TTS & Voice Output (Edge-TTS is free, no API key needed)
# ---------------------------------------------------------------------------
TTS_VOICE=en-GB-RyanNeural

# Optional: Sarvam TTS for Indian English context
# SARVAM_API_KEY=your_sarvam_key
